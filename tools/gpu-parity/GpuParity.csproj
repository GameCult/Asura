<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CultLib checkout; env CULTLIB_ROOT, else a sibling directory named CultLib. -->
    <CultLibRoot Condition="'$(CULTLIB_ROOT)' != ''">$(CULTLIB_ROOT)</CultLibRoot>
    <CultLibRoot Condition="'$(CultLibRoot)' == ''">$(MSBuildThisFileDirectory)../../../CultLib</CultLibRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.2" />
    <ProjectReference Include="$(CultLibRoot)/packages/cultmath/src/CultMath/CultMath.csproj" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CultLibRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(CultLibRoot)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
